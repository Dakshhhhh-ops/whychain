# Copy to .env and fill in. Never commit .env.

# ---------- Data harness ----------
# "zetaris" (primary) or "local" (DuckDB fallback over the same sources and table names)
WHYCHAIN_HARNESS=zetaris
# Local Zetaris platform (the Docker bundle): its UI/API address and the admin login from the bundle's .env
ZETARIS_URL=http://localhost:3000
# Folder of the Zetaris Docker bundle (start.cmd starts it from there)
ZETARIS_DIR=C:\path\to\zetaris-platform
ZETARIS_USER=your-zetaris-admin-email
ZETARIS_PASSWORD=your-zetaris-admin-password
# Where the bundle sees WhyChain's data files (mounted with docs/zetaris-override.yml), and how it reaches Postgres
ZETARIS_DATA_ROOT=/home/zetaris/customer-data/shared/whychain
ZETARIS_PG_HOST=host.docker.internal
# Zetaris Cloud instead of the local platform: leave ZETARIS_USER empty and set these
ZETARIS_REST_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=

# Local ERP database (docker compose up -d)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=erp
POSTGRES_USER=whychain
POSTGRES_PASSWORD=whychain-local

# ---------- Models (all OpenAI-compatible) ----------
# xAI Grok: Planner, Evaluator, Risk & Action, Reporter
XAI_API_KEY=xai-your-key
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast

# NVIDIA NIM: Nemotron 3.5 Super for every agent role.
# Thinking off for fast data/document work, on for planning, judging and writing.
NVIDIA_API_KEY=nvapi-your-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NIM_THINKING=false
NIM_BACKUP_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # a different NIM model, used when the main one fails
NIM_REASON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NIM_REASON_THINKING=true

# Meterless Nightshift: reads the written record on this machine's GPU when "Private documents" is ticked
# (contracts, email and news never leave the machine). Off by default: Nemotron reads them otherwise.
# Token: the runtime writes it to <stateDir>/proxy-token
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=your-nightshift-proxy-token
NIGHTSHIFT_MODEL=meterless/local   # on-device only: Nightshift never routes it to a cloud provider
# true: every run reads documents privately unless the app's checkbox says otherwise
WHYCHAIN_PRIVATE_DOCS=false
# Nightshift as the gateway for every model call: the same Nemotron models, reached through Nightshift's cloud lane
# (a signed receipt per call). Needs, in Nightshift: the NVIDIA key (Setup > Providers), a cloud lane
# "nemotron-cloud" (provider nvidia, model below) and the app policy "whychain-gateway" pinned to that lane.
# Direct NVIDIA NIM stays the fallback. Slower: through Nightshift the model always reasons before answering.
NIGHTSHIFT_PRIMARY=false
NIGHTSHIFT_GATEWAY_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Ollama: optional offline fallback
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# ---------- Meterless engines bridge (cd meterless_bridge && npm start) ----------
METERLESS_BRIDGE_URL=http://localhost:8787
# H-MEM recall embeddings: "nvidia" (NVIDIA Nemotron via NIM, the default when NVIDIA_API_KEY is set) or "mock"
# (H-MEM's deterministic reference embedder). The bridge reads NVIDIA_API_KEY from this file.
METERLESS_EMBEDDER=nvidia
METERLESS_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# ---------- Behaviour ----------
WHYCHAIN_MAX_ROUNDS=2
# Fixes costing more than this (INR) need human approval
WHYCHAIN_APPROVAL_THRESHOLD_INR=300000
