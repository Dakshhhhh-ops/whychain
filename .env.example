# Copy to .env and fill in. Never commit .env.

# ---------- Data harness ----------
# "zetaris" (primary) or "local" (DuckDB fallback over the same sources and table names)
WHYCHAIN_HARNESS=zetaris
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_ORG_ID=your-numeric-org-id
# How the Zetaris container reaches the ERP database and the generated files (see scripts/register_zetaris.py)
ZETARIS_PG_JDBC_URL=jdbc:postgresql://host.docker.internal:5433/erp
ZETARIS_FILE_PREFIX=/data/whychain

# Local ERP database (docker compose up -d)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=erp
POSTGRES_USER=whychain
POSTGRES_PASSWORD=whychain-local

# ---------- Models (all OpenAI-compatible) ----------
# xAI Grok: Planner, Evaluator, Risk & Action, Reporter
XAI_API_KEY=xai-your-key
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast

# NVIDIA NIM: Nemotron 3.5 Super for every agent role.
# Thinking off for fast data/document work, on for planning, judging and writing.
NVIDIA_API_KEY=nvapi-your-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NIM_THINKING=false
NIM_REASON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NIM_REASON_THINKING=true

# Meterless Nightshift: Document Analyst on the local NVIDIA GPU (contracts and email never leave the machine)
# Token: the runtime writes it to <stateDir>/proxy-token
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=your-nightshift-proxy-token
NIGHTSHIFT_MODEL=meterless/local

# Ollama: optional offline fallback
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# ---------- Meterless engines bridge (cd meterless_bridge && npm start) ----------
METERLESS_BRIDGE_URL=http://localhost:8787

# ---------- Behaviour ----------
WHYCHAIN_MAX_ROUNDS=2
# Fixes costing more than this (INR) need human approval
WHYCHAIN_APPROVAL_THRESHOLD_INR=300000
